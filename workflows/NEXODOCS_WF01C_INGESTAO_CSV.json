      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nconst text = rows.map((r, index) => [\n  `Registro ${index + 1}`,\n  `Área: ${r.area}`,\n  `Responsável: ${r.responsavel}`,\n  `E-mail: ${r.email}`,\n  `Ramal: ${r.ramal}`,\n  `Escopo: ${r.escopo}`\n].join('\\n')).join('\\n\\n---\\n\\n');\n\nreturn [{\n  json: {\n    data: text,\n    document_id: 'CH-DIR-001',\n    document_version: '1.0',\n    document_type: 'corporate_directory',\n    source: 'Clínica Horizonte - Diretório Corporativo',\n    source_file: 'diretorio_corporativo_clinica_horizonte_v1.0.csv',\n    classification: 'uso_interno',\n    language: 'pt-BR',\n    status: 'vigente',\n    record_count: rows.length\n  }\n}];"
